{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "type": "registry:theme",
  "title": "vizcn theme tokens",
  "description": "Structural --vz-* tokens (light + dark + terminal). Namespaced: installing vizcn never repaints your app.",
  "cssVars": {
    "light": {
      "vz-surface": "#ffffff",
      "vz-frame": "#e3e3e3",
      "vz-grid": "#ededed",
      "vz-axis": "#d9d9d9",
      "vz-track": "#f5f5f4",
      "vz-ink": "#111111",
      "vz-text2": "#3a3a3a",
      "vz-text3": "#5c5c5c",
      "vz-muted": "#8a8a8a",
      "vz-muted2": "#9c9c9c",
      "vz-chip": "#111111",
      "vz-chip-ink": "#ffffff",
      "vz-ring": "#ffffff",
      "vz-hover": "#f7f7f6",
      "vz-good": "#059669",
      "vz-mid": "#d97706",
      "vz-bad": "#dc2626"
    },
    "dark": {
      "vz-surface": "#0e0e11",
      "vz-frame": "#26262b",
      "vz-grid": "#1e1e23",
      "vz-axis": "#3d3d44",
      "vz-track": "#1a1a1f",
      "vz-ink": "#f2f2f0",
      "vz-text2": "#c9c9c5",
      "vz-text3": "#a3a39f",
      "vz-muted": "#8c8c8a",
      "vz-muted2": "#7e7e7c",
      "vz-chip": "#f2f2f0",
      "vz-chip-ink": "#111111",
      "vz-ring": "#0e0e11",
      "vz-hover": "#16161a"
    }
  },
  "css": {
    ".vz-terminal": {
      "--vz-surface": "#111111",
      "--vz-frame": "rgba(255, 255, 255, 0.12)",
      "--vz-grid": "rgba(255, 255, 255, 0.07)",
      "--vz-axis": "rgba(255, 255, 255, 0.22)",
      "--vz-track": "rgba(255, 255, 255, 0.05)",
      "--vz-ink": "rgba(255, 255, 255, 0.94)",
      "--vz-text2": "rgba(255, 255, 255, 0.78)",
      "--vz-text3": "rgba(255, 255, 255, 0.62)",
      "--vz-muted": "rgba(255, 255, 255, 0.52)",
      "--vz-muted2": "rgba(255, 255, 255, 0.44)",
      "--vz-chip": "#ff7a1a",
      "--vz-chip-ink": "#111111",
      "--vz-ring": "#111111",
      "--vz-hover": "rgba(255, 255, 255, 0.08)",
      "--vz-good": "#4ade80",
      "--vz-mid": "#ff7a1a",
      "--vz-bad": "#f87171",
      "color-scheme": "dark"
    }
  }
}